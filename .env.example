# ==========================================================
# DisasterShield AI - Environment Configuration Example
# ==========================================================
# Copy this file to .env and adjust variables as needed.
# If these variables are not set, the application automatically runs
# in transparent, safe DEMO MODE.

# Gemma 4 Inference Endpoint Configuration
# (Supported: Ollama endpoint or OpenAI-compatible Gemma 4 server)
GEMMA_ENDPOINT_URL=http://localhost:11434
GEMMA_MODEL_NAME=gemma4:e2b
GEMMA_API_KEY=
GEMMA_TIMEOUT_SECONDS=10

# Default Demonstration Coordinates (Default: Prayagraj, UP, India)
DEFAULT_LOCATION_NAME=Prayagraj, Uttar Pradesh, India
DEFAULT_LAT=25.4358
DEFAULT_LON=81.8463

# Administrator Verification Workflow PIN
# (Default for demo: 1122)
ADMIN_VERIFY_PIN=1122

# Weather Integration
# (Uses free Open-Meteo API, no key required)
ENABLE_LIVE_WEATHER=true
WEATHER_API_TIMEOUT=5
